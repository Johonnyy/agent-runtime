# agent-runtime configuration. Every key is prefixed AGENT_RUNTIME_ so it cannot
# collide with the host app's own settings (Amber uses AMBER_, agent-mcp-py uses
# AGENT_MCP_) when all three are loaded into one process.

# --- OpenRouter ---
AGENT_RUNTIME_OPENROUTER_API_KEY=
# Override only if you're pointing at a proxy or a local OpenAI-compatible server.
AGENT_RUNTIME_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter attribution headers — optional, they surface your app on its leaderboards.
AGENT_RUNTIME_REFERER=
AGENT_RUNTIME_TITLE=

# --- Identity ---
# Stamped into every usage row so a shared database stays attributable.
AGENT_RUNTIME_APP_NAME=unknown

# --- Model defaults ---
AGENT_RUNTIME_DEFAULT_TIER=balanced
AGENT_RUNTIME_MAX_TOKENS=1024
AGENT_RUNTIME_MAX_STEPS=5
AGENT_RUNTIME_REQUEST_TIMEOUT_S=60.0

# --- Cost tracking ---
# Point this at the host app's existing database to keep one file per app
# (Amber sets it to amber.db). Tables are prefixed, so co-tenancy is safe.
AGENT_RUNTIME_DB_PATH=agent_runtime.db
AGENT_RUNTIME_FEATURE_COST_TRACKING=true
